---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { db } from '../db';
import { posts, users } from '../db/schema';
import { desc, eq, and, lte, like, or } from 'drizzle-orm';
import Badge from '../components/ui/Badge.astro';
import { getSiteSettings } from '../lib/settings';
const siteSettings = await getSiteSettings();
const url = new URL(Astro.request.url);
const q = url.searchParams.get('q');
let publishedPosts = [];
let errorMsg = '';
try {
    if (q) {
        publishedPosts = await db
            .select({
                id: posts.id,
                title: posts.title,
                slug: posts.slug,
                excerpt: posts.excerpt,
                tags: posts.tags,
                publishedAt: posts.publishedAt,
                readingTime: posts.readingTime,
                author: users.username,
            })
            .from(posts)
            .innerJoin(users, eq(posts.authorId, users.id))
            .where(
                and(
                    eq(posts.status, 'published'),
                    lte(posts.publishedAt, Date.now()),
                    or(
                        like(posts.title, `%${q}%`),
                        like(posts.content, `%${q}%`),
                        like(posts.tags, `%${q}%`),
                    ),
                ),
            )
            .orderBy(desc(posts.publishedAt))
            .all();
    } else {
        publishedPosts = await db
            .select({
                id: posts.id,
                title: posts.title,
                slug: posts.slug,
                excerpt: posts.excerpt,
                tags: posts.tags,
                publishedAt: posts.publishedAt,
                readingTime: posts.readingTime,
                author: users.username,
            })
            .from(posts)
            .innerJoin(users, eq(posts.authorId, users.id))
            .where(and(eq(posts.status, 'published'), lte(posts.publishedAt, Date.now())))
            .orderBy(desc(posts.publishedAt))
            .all();
    }
} catch (e) {
    errorMsg = 'Database error: ' + e.message;
}
const siteSchema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteSettings.site_name,
    url: Astro.site,
    description: siteSettings.site_subtitle,
    potentialAction: {
        '@type': 'SearchAction',
        target: {
            '@type': 'EntryPoint',
            urlTemplate: `${Astro.site}?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
    },
};
---

<Layout title={siteSettings.site_name}>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    </Fragment>
    <Header siteName={siteSettings.site_name} />
    <main class="container mx-auto max-w-4xl py-6 lg:py-10 px-4">
        {
            errorMsg && (
                <div
                    class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4"
                    role="alert"
                >
                    <strong class="font-bold">Error!</strong>
                    <span class="block sm:inline">{errorMsg}</span>
                </div>
            )
        }
        <div class="max-w-2xl mx-auto w-full flex flex-col items-start text-left gap-4 mb-12">
            <h1 class="font-bold text-4xl tracking-tight lg:text-6xl">{siteSettings.site_title}</h1>
            <p class="text-xl text-slate-500 dark:text-slate-400">
                {siteSettings.site_subtitle}
            </p>
        </div>

        {
            q && (
                <p class="mb-8 text-lg text-slate-500 dark:text-slate-400 text-center">
                    Search results for "
                    <span class="font-semibold text-slate-900 dark:text-slate-50">{q}</span>"
                </p>
            )
        }

        <div class="flex flex-col gap-10 max-w-2xl mx-auto">
            {
                publishedPosts.map((post) => (
                    <article class="group relative flex flex-col space-y-3">
                        <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                            {post.publishedAt && (
                                <time datetime={new Date(post.publishedAt).toISOString()}>
                                    {new Date(post.publishedAt).toLocaleDateString()}
                                </time>
                            )}
                            <span>•</span>
                            <span>{post.readingTime}</span>
                        </div>
                        <h2 class="text-3xl font-bold tracking-tight lg:text-4xl">
                            <a href={`/blog/${post.slug}`} class="absolute inset-0">
                                <span class="sr-only">View Article</span>
                            </a>
                            {post.title}
                        </h2>
                        {post.excerpt && (
                            <p class="text-slate-500 dark:text-slate-400 text-lg leading-relaxed">
                                {post.excerpt}
                            </p>
                        )}
                        {post.tags && (
                            <div class="flex flex-wrap gap-2 pt-1 relative z-10">
                                {post.tags.split(',').map((tag) => (
                                    <a href={`/?q=${tag.trim()}`} class="inline-block">
                                        <Badge variant="secondary">#{tag.trim()}</Badge>
                                    </a>
                                ))}
                            </div>
                        )}
                        <div class="text-sm text-slate-500 dark:text-slate-400 pt-1">
                            <span>By {post.author}</span>
                        </div>
                    </article>
                ))
            }
            {
                publishedPosts.length === 0 && !errorMsg && (
                    <p class="text-slate-500 col-span-full text-center py-10">No posts found.</p>
                )
            }
        </div>
    </main>
</Layout>
