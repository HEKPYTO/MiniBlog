---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { db } from '../../db';
import { posts, users } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { getMarkdownParser } from '../../lib/markdown';
import Badge from '../../components/ui/Badge.astro';
const { slug } = Astro.params;
const user = Astro.locals.user;
if (!slug) {
    return Astro.redirect('/404');
}
const post = await db
    .select({
        id: posts.id,
        title: posts.title,
        content: posts.content,
        publishedAt: posts.publishedAt,
        readingTime: posts.readingTime,
        author: users.username,
        tags: posts.tags,
        excerpt: posts.excerpt,
    })
    .from(posts)
    .innerJoin(users, eq(posts.authorId, users.id))
    .where(eq(posts.slug, slug))
    .get();
if (!post) {
    return Astro.redirect('/404');
}
const md = await getMarkdownParser();
const contentHtml = md.render(post.content);
const ogImage = new URL(`/og/${slug}.png`, Astro.url);
const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    image: [ogImage.toString()],
    datePublished: post.publishedAt
        ? new Date(post.publishedAt).toISOString()
        : new Date().toISOString(),
    author: [
        {
            '@type': 'Person',
            name: post.author,
        },
    ],
    description: post.excerpt || post.title,
};
---

<Layout
    title={post.title}
    description={post.excerpt || post.title}
    image={ogImage.toString()}
    type="article"
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    </Fragment>
    <Header />
    <article class="container mx-auto max-w-3xl py-6 lg:py-12 px-4">
        <div class="space-y-4 text-left">
            <div class="flex items-center gap-4 text-slate-500 dark:text-slate-400 text-sm">
                {
                    post.publishedAt && (
                        <time datetime={new Date(post.publishedAt).toISOString()}>
                            {new Date(post.publishedAt).toLocaleDateString()}
                        </time>
                    )
                }
                <span>•</span>
                <span>{post.readingTime}</span>
            </div>
            <h1 class="text-4xl font-bold tracking-tight lg:text-5xl flex items-center gap-3 group">
                {post.title}
                {
                    user && (user.role === 'admin' || user.role === 'owner') && (
                        <a
                            href={`/admin/editor?id=${post.id}`}
                            class="opacity-0 group-hover:opacity-100 transition-opacity text-slate-400 hover:text-slate-900 dark:hover:text-slate-100"
                            title="Edit Post"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="w-6 h-6 lg:w-8 lg:h-8"
                            >
                                <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                            </svg>
                        </a>
                    )
                }
            </h1>
            {
                post.tags && (
                    <div class="flex flex-wrap gap-2 mt-4">
                        {post.tags.split(',').map((tag) => (
                            <a href={`/?q=${tag.trim()}`}>
                                <Badge
                                    variant="secondary"
                                    class="hover:bg-slate-200 dark:hover:bg-slate-700"
                                >
                                    #{tag.trim()}
                                </Badge>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
        <hr class="my-8 border-slate-200 dark:border-slate-800" />
        <div
            class="prose prose-slate dark:prose-invert mx-auto max-w-none"
            set:html={contentHtml}
        />
    </article>
</Layout>
