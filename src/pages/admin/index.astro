---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { db } from '../../db';
import { posts, users } from '../../db/schema';
import { desc, asc, eq, like, or, and } from 'drizzle-orm';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect('/login');
}
if (user.role !== 'admin' && user.role !== 'owner') {
    return Astro.redirect('/');
}

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const action = formData.get('action');
    const id = formData.get('id');
    if (action === 'delete' && id) {
        await db.delete(posts).where(eq(posts.id, id));
    }
    return Astro.redirect(Astro.url.href);
}

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') || '';
const sort = url.searchParams.get('sort') || '';
const order = url.searchParams.get('order') || '';

let orderBy;
if (sort === 'publishedAt') {
    orderBy = order === 'asc' ? asc(posts.publishedAt) : desc(posts.publishedAt);
} else if (sort === 'status') {
    orderBy = order === 'asc' ? asc(posts.status) : desc(posts.status);
} else if (sort === 'title') {
    orderBy = order === 'asc' ? asc(posts.title) : desc(posts.title);
} else {
    orderBy = desc(posts.publishedAt);
}

const filters = [eq(posts.authorId, users.id)];
if (q) {
    filters.push(or(like(posts.title, `%${q}%`), like(posts.tags, `%${q}%`)));
}

const allPosts = await db
    .select({
        id: posts.id,
        title: posts.title,
        slug: posts.slug,
        status: posts.status,
        publishedAt: posts.publishedAt,
        author: users.username,
    })
    .from(posts)
    .innerJoin(users, eq(posts.authorId, users.id))
    .where(and(...filters))
    .orderBy(orderBy)
    .all();

function getSortLink(column) {
    const params = new URLSearchParams(url.searchParams);
    if (sort === column) {
        if (order === 'desc') {
            params.set('order', 'asc');
        } else if (order === 'asc') {
            params.delete('sort');
            params.delete('order');
        } else {
            params.set('order', 'desc');
        }
    } else {
        params.set('sort', column);
        params.set('order', 'desc');
    }
    return `?${params.toString()}`;
}
---

<Layout title="Admin Dashboard">
    <Header />
    <main class="container mx-auto max-w-5xl py-8 px-4">
        <div class="flex flex-col md:flex-row items-center gap-4 mb-8 w-full">
            <form method="get" class="flex flex-1 gap-2 w-full md:w-auto" id="search-form">
                <Input
                    type="text"
                    name="q"
                    value={q}
                    placeholder="Search title or tags..."
                    class="h-9 w-full"
                    oninput="this.form.submit()"
                    autofocus={!!q}
                />
                {
                    q && (
                        <a href="/admin" class="flex items-center">
                            <Button variant="ghost" type="button" class="h-9">
                                Clear
                            </Button>
                        </a>
                    )
                }
            </form>

            <div class="flex items-center gap-4 shrink-0">
                <h1 class="text-2xl font-bold whitespace-nowrap">Dashboard</h1>
                {
                    user.role === 'owner' && (
                        <a href="/admin/users" class="inline-flex">
                            <Button variant="outline" class="h-9">
                                Users
                            </Button>
                        </a>
                    )
                }
                <a href="/admin/editor" class="inline-flex">
                    <Button class="h-9">New Post</Button>
                </a>
            </div>
        </div>

        <div
            class="rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 overflow-hidden"
        >
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead
                        class="text-xs text-slate-700 uppercase bg-slate-50 dark:bg-slate-900 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800"
                    >
                        <tr>
                            <th class="px-6 py-3 w-1/3 align-middle">
                                <a
                                    href={getSortLink('title')}
                                    class="inline-flex items-center gap-1 group"
                                >
                                    <span>Title</span>
                                    {
                                        sort === 'title' &&
                                            (order === 'asc' ? (
                                                <span>&uarr;</span>
                                            ) : (
                                                <span>&darr;</span>
                                            ))
                                    }
                                </a>
                            </th>
                            <th class="px-6 py-3 w-1/6 text-center align-middle">
                                <a
                                    href={getSortLink('status')}
                                    class="inline-flex items-center justify-center gap-1 group"
                                >
                                    <span>Status</span>
                                    {
                                        sort === 'status' &&
                                            (order === 'asc' ? (
                                                <span>&uarr;</span>
                                            ) : (
                                                <span>&darr;</span>
                                            ))
                                    }
                                </a>
                            </th>
                            <th
                                class="px-6 py-3 cursor-pointer select-none w-1/6 text-center align-middle"
                            >
                                <a
                                    href={getSortLink('publishedAt')}
                                    class="inline-flex items-center justify-center gap-1 group"
                                >
                                    <span>Date</span>
                                    {
                                        sort === 'publishedAt' &&
                                            (order === 'asc' ? (
                                                <span>&uarr;</span>
                                            ) : (
                                                <span>&darr;</span>
                                            ))
                                    }
                                </a>
                            </th>

                            <th class="px-6 py-3 w-1/6 text-center align-middle">Author</th>

                            <th class="px-6 py-3 w-1/6 text-center align-middle">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            allPosts.map((post) => (
                                <tr class="border-b border-slate-200 dark:border-slate-800 last:border-0 hover:bg-slate-50/50 dark:hover:bg-slate-900/50">
                                    <td class="px-6 py-4 font-medium">
                                        <a
                                            href={`/admin/editor?id=${post.id}`}
                                            class="hover:underline underline-offset-4"
                                        >
                                            {post.title}
                                        </a>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <Badge
                                            variant={
                                                post.status === 'published' ? 'success' : 'warning'
                                            }
                                        >
                                            {post.status}
                                        </Badge>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        {post.publishedAt
                                            ? new Date(post.publishedAt).toLocaleDateString()
                                            : '-'}
                                    </td>

                                    <td class="px-6 py-4 text-center">{post.author}</td>

                                    <td class="px-6 py-4 text-center">
                                        <a
                                            href={`/admin/editor?id=${post.id}`}
                                            class="inline-flex items-center justify-center h-8 w-8 text-slate-900 hover:bg-slate-100 rounded-md dark:text-slate-50 dark:hover:bg-slate-800"
                                        >
                                            <span class="sr-only">Edit</span>
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="16"
                                                height="16"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="lucide lucide-pencil"
                                            >
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                                <path d="m15 5 4 4" />
                                            </svg>
                                        </a>
                                        <form
                                            method="post"
                                            class="inline-block ml-1"
                                            onsubmit="return confirm('Delete post?');"
                                        >
                                            <input type="hidden" name="action" value="delete" />
                                            <input type="hidden" name="id" value={post.id} />
                                            <Button
                                                variant="ghost"
                                                size="icon"
                                                class="h-8 w-8 text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-950/50"
                                            >
                                                <span class="sr-only">Delete</span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="lucide lucide-trash-2"
                                                >
                                                    <path d="M3 6h18" />
                                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                    <line x1="10" x2="10" y1="11" y2="17" />
                                                    <line x1="14" x2="14" y1="11" y2="17" />
                                                </svg>
                                            </Button>
                                        </form>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</Layout>
