---
import { twMerge } from 'tailwind-merge';
import { clsx } from 'clsx';

const { class: className, ...props } = Astro.props;

const classes = twMerge(
    clsx(
        'flex h-9 w-full items-center justify-between rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-50',
        className,
    ),
);
---

<select class={classes} {...props}>
    <slot />
</select>
