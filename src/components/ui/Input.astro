---
import { twMerge } from 'tailwind-merge';
import { clsx } from 'clsx';

const { class: className, type = 'text', ...props } = Astro.props;

const classes = twMerge(
    clsx(
        'flex h-10 w-full rounded-md border border-transparent px-3 py-2 text-sm',
        'ring-offset-white',

        'bg-slate-100',

        'file:border-0 file:bg-transparent file:text-sm file:font-medium',

        'placeholder:text-slate-500',

        'hover:bg-slate-200',
        'transition-all duration-200 ease-in-out',
        'focus-visible:outline-none focus-visible:bg-white focus-visible:shadow-sm',
        'disabled:cursor-not-allowed disabled:opacity-50',

        'dark:bg-slate-800',
        'dark:placeholder:text-slate-400',
        'dark:hover:bg-slate-700',
        'dark:focus-visible:bg-slate-950 dark:focus-visible:shadow-sm',

        className,
    ),
);
---

<input type={type} class={classes} {...props} />
